# Copy to .env.local for local development (see README).
# Values: Supabase project settings → API (Project URL and anon public key).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional (AI Studio template; only if your build uses Gemini)
GEMINI_API_KEY=